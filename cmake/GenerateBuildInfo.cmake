# Script mode: cmake -DSOURCE_DIR=... -DOUTPUT=... -DVERSION=... -P GenerateBuildInfo.cmake
#
# Runs on every build (see lp_core/CMakeLists.txt) so the hash never goes stale
# after a commit without reconfigure. The header is only rewritten when its
# content changes, so an unchanged hash triggers no recompilation.

set(hash "")
set(dirty "")

find_package(Git QUIET)
if(GIT_FOUND)
    execute_process(COMMAND "${GIT_EXECUTABLE}" rev-parse --short=8 HEAD
        WORKING_DIRECTORY "${SOURCE_DIR}"
        OUTPUT_VARIABLE hash OUTPUT_STRIP_TRAILING_WHITESPACE
        RESULT_VARIABLE rv ERROR_QUIET)
    if(NOT rv EQUAL 0)
        set(hash "")
    else()
        execute_process(COMMAND "${GIT_EXECUTABLE}" status --porcelain --untracked-files=no
            WORKING_DIRECTORY "${SOURCE_DIR}"
            OUTPUT_VARIABLE status OUTPUT_STRIP_TRAILING_WHITESPACE
            RESULT_VARIABLE rv ERROR_QUIET)
        if(rv EQUAL 0 AND NOT status STREQUAL "")
            set(dirty "-dirty")
        endif()
    endif()
endif()

# CI fallback (e.g. source tarball without .git)
if(hash STREQUAL "" AND DEFINED ENV{GITHUB_SHA})
    string(SUBSTRING "$ENV{GITHUB_SHA}" 0 8 hash)
endif()
if(hash STREQUAL "")
    set(hash "unknown")
endif()

set(content "// Generated by cmake/GenerateBuildInfo.cmake. Do not edit.
#pragma once

namespace lp::build
{
    inline constexpr const char* version = \"${VERSION}\";
    inline constexpr const char* gitHash = \"${hash}${dirty}\";
}
")

if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" old)
else()
    set(old "")
endif()
if(NOT old STREQUAL content)
    file(WRITE "${OUTPUT}" "${content}")
endif()
